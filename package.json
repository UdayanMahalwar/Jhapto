{
  "name": "jhapto",
  "version": "1.0.0",
  "description": "Jhapto - Hostel Quick Commerce Platform",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "NODE_ENV=production node server.js",
    "build": "vite build jhapto-frontend",
    "test": "jest --runInBand",
    "db:setup": "node jhapto-backend/scripts/setup_db.js",
    "images:migrate": "node jhapto-backend/scripts/migrate_base64_images.js",
    "lint": "eslint jhapto-frontend/src"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^14.7.1",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^1.14.0",
    "multer": "^2.5.0",
    "mysql2": "^3.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vite": "^6.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/jhapto-backend/tests"
    ],
    "setupFiles": [
      "<rootDir>/jhapto-backend/tests/helpers/env.js"
    ],
    "transform": {},
    "testTimeout": 20000
  },
  "engines": {
    "node": ">=20"
  }
}
