{
  "appId": "com.jhapto.app",
  "appName": "Jhapto",
  "webDir": "www",
  "server": {
    "url": "https://jhapto.vercel.app",
    "errorPath": "offline.html",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#edebe8",
    "appendUserAgent": "JhaptoAndroid/1.1"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      },
      "logLevel": 1
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
