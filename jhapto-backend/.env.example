# Local MySQL (Homebrew mysql@8.4)
DB_HOST=localhost
DB_PORT=3306
DB_USER=jhapto
DB_PASSWORD=your_mysql_password
DB_NAME=jhapto

JWT_SECRET=change_me

# Set to true to run without MySQL (in-memory mock data)
USE_MOCK_DB=false

# Port for the app (frontend + API + live chat). Default 3000.
# PORT=3000
