# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=jhapto
DB_PASSWORD=your_postgres_password
DB_NAME=jhapto
# Hosted (Neon): set DATABASE_URL instead of the DB_* values above
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET=change_me

# Set to true to run without MySQL (in-memory mock data)
USE_MOCK_DB=false

# Port for the app (frontend + API + live chat). Default 3000.
# PORT=3000
